# Stripe test mode only
STRIPE_SECRET_KEY=sk_test_...
# Claude (or ANTHROPIC_BASE_URL for an Anthropic-compatible proxy such as OpenRouter)
ANTHROPIC_API_KEY=sk-ant-...
# Cognee Cloud (can also live in ~/.cognee/.env); without it, memory falls back to a local mirror
COGNEE_BASE_URL=https://tenant-....aws.cognee.ai
COGNEE_API_KEY=...
# Optional
SIXMIN_MODEL=claude-opus-5-5
SIXMIN_EFFORT=medium
